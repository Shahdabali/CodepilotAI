GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
DB_PATH=.codepilot.db
MAX_ITERATIONS=10
DEFAULT_AUTONOMY_LEVEL=BALANCED
EXECUTION_TIMEOUT=60000
CORS_ORIGIN=http://localhost:5173

# GitHub Explorer (optional)
# GITHUB_TOKEN=                            # 5,000 requests/hour instead of 60. Server-side only; also read from GH_TOKEN / GITHUB_API_KEY
# WORKSPACE_ROOT=                          # where new / cloned projects go by default (default: the folder that contains this repo)

# API Fetcher (all optional)
# API_FETCHER_ALLOW_PRIVATE_NETWORK=true   # default: true in dev, false in production
# API_FETCHER_MAX_RESPONSE_BYTES=26214400  # response capture limit (max 104857600)
# API_FETCHER_ENCRYPTION_KEY=              # set to encrypt environment secrets at rest
